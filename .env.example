# Local development database. Never reuse these credentials in production.
DATABASE_URL=postgresql://kampus:kampus_local@127.0.0.1:5432/kampus

# Generate a unique production value with: openssl rand -base64 48
AUTH_SECRET=replace-this-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000

# Read the client IP from exactly one header set by your trusted reverse proxy.
# Vercel commonly uses x-forwarded-for; Cloudflare uses cf-connecting-ip.
TRUSTED_CLIENT_IP_HEADER=x-forwarded-for

# Local Mailpit SMTP. Replace these with your production email provider values.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=10000
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=KAMPUS <no-reply@kampus.local>

# Used only by the isolated database integration test suite.
TEST_DATABASE_URL=postgresql://kampus_test:kampus_test_local@127.0.0.1:5433/kampus_test
