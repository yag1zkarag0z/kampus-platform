{
  "name": "kampus-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --import tsx ./scripts/server.ts --dev",
    "build": "next build",
    "start": "node --import tsx ./scripts/server.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --pretty false --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:prepare": "npm run db:test:migrate && tsx scripts/cleanup-e2e.ts",
    "test:e2e": "npm run test:e2e:prepare && playwright test",
    "test:e2e:ui": "npm run test:e2e:prepare && playwright test --ui",
    "test:load": "tsx scripts/load-test.ts",
    "test:db": "npm run db:test:migrate && vitest run --config vitest.db.config.mts",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run test:db && npm run test:e2e",
    "deploy:check": "node --import tsx ./scripts/check-runtime-configuration.ts",
    "deploy:migrate": "node --import tsx ./scripts/migrate-production.ts",
    "deploy:prepare": "npm run deploy:check && npm run deploy:migrate",
    "maintenance:dry-run": "tsx scripts/maintenance-worker.ts --dry-run",
    "maintenance:once": "tsx scripts/maintenance-worker.ts --once",
    "maintenance:worker": "tsx scripts/maintenance-worker.ts",
    "avatars:generate": "tsx scripts/generate-avatar-presets.ts",
    "db:up": "docker compose up -d postgres mailpit",
    "db:test:up": "docker compose up -d postgres-test mailpit",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:test:migrate": "drizzle-kit migrate --config=drizzle.test.config.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:make-admin": "tsx scripts/make-admin.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1108.0",
    "@aws-sdk/client-s3": "^3.1101.0",
    "@dicebear/avataaars": "9.4.2",
    "@dicebear/core": "9.4.2",
    "@gsap/react": "^2.1.2",
    "@next/env": "^16.3.0",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "next": "16.3.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "comments": {
    "overrides": "Next kendi sharp'ını getiriyor. İki kopya kurulunca Windows aynı isimli libvips-42.dll'i ikinci kez yüklemediği için bir sürümün addon'u diğerinin libvips'ine bağlanıyor ve next/og PNG üretirken çöküyor. Tek sürüme sabitliyoruz."
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "brace-expansion@1.1.16": "1.1.18",
    "brace-expansion@5.0.8": "5.0.9",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.17",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
