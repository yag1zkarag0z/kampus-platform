        "otp_challenges_email_student_domain_check": {
          "name": "otp_challenges_email_student_domain_check",
          "value": "\"otp_challenges\".\"email\"::text = btrim(\"otp_challenges\".\"email\"::text)\n        and lower(\"otp_challenges\".\"email\"::text) ~ '^[^@[:space:]]+@stu[.]yasar[.]edu[.]tr$'"
