        "otp_challenges_expiration_order_check": {
          "name": "otp_challenges_expiration_order_check",
          "value": "\"otp_challenges\".\"expires_at\" > \"otp_challenges\".\"created_at\"\n        and \"otp_challenges\".\"expires_at\" <= \"otp_challenges\".\"created_at\" + interval '5 minutes'"
        },
        "otp_challenges_resend_order_check": {
          "name": "otp_challenges_resend_order_check",
          "value": "\"otp_challenges\".\"resend_available_at\" >= \"otp_challenges\".\"created_at\" + interval '30 seconds'\n        and \"otp_challenges\".\"resend_available_at\" < \"otp_challenges\".\"expires_at\""
        },
        "otp_challenges_verified_at_order_check": {
          "name": "otp_challenges_verified_at_order_check",
          "value": "\"otp_challenges\".\"verified_at\" is null\n        or (\"otp_challenges\".\"verified_at\" >= \"otp_challenges\".\"created_at\"\n          and \"otp_challenges\".\"verified_at\" <= \"otp_challenges\".\"expires_at\")"
        },
        "otp_challenges_consumed_at_order_check": {
          "name": "otp_challenges_consumed_at_order_check",
          "value": "\"otp_challenges\".\"consumed_at\" is null\n        or (\n          \"otp_challenges\".\"consumed_at\" >= \"otp_challenges\".\"created_at\"\n          and (\n            (\"otp_challenges\".\"purpose\" = 'login'\n              and \"otp_challenges\".\"consumed_at\" <= \"otp_challenges\".\"expires_at\")\n            or (\n              \"otp_challenges\".\"purpose\" = 'registration'\n              and \"otp_challenges\".\"verified_at\" is not null\n              and \"otp_challenges\".\"consumed_at\"\n                <= \"otp_challenges\".\"verified_at\" + interval '15 minutes'\n            )\n          )\n        )"
        }
